# ====================================
# HUGO PROSPECTOR — configuração
# ====================================

# Servidor
PORT=3920
NODE_ENV=production

# ── NICHO ──
# Define o tipo de profissional a prospectar.
# Pode ser qualquer profissional com clínica/escritório listado no Google Maps.
# Exemplos: dermatologista, dentista, advogado, esteticista, arquiteto, contador
NICHE=dermatologista

# Cidades-alvo (separadas por vírgula). Formato: Cidade-UF
# A cada execução, HUGO rotaciona 2 cidades pra economizar requests.
CITIES=Curitiba-PR,São Paulo-SP,Belo Horizonte-MG,Rio de Janeiro-RJ

# ── EXECUÇÃO ──
# Cron schedule (formato cron padrão). Default: todo dia às 7h.
RUN_AT=0 7 * * *

# Máximo de leads por fonte por execução
MAX_PER_SOURCE=20

# Score mínimo pra considerar lead qualificado (0-100)
SCORE_THRESHOLD=50

# ── OUTPUT ──
# csv         → exporta CSV em ./data/exports/ (recomendado pra começar)
# leadflow    → envia pra LeadFlow CRM (precisa preencher credenciais abaixo)
# both        → faz os dois
OUTPUT_MODE=csv

# ── LEADFLOW (opcional) ──
# Só preencha se OUTPUT_MODE=leadflow ou OUTPUT_MODE=both
LEADFLOW_URL=
LEADFLOW_EMAIL=
LEADFLOW_PASSWORD=
LEADFLOW_FUNNEL_NAME=Prospecção HUGO

# ── PLAYWRIGHT ──
# Caminho do Chromium (Linux: /usr/bin/chromium-browser, Mac: deixa vazio)
CHROMIUM_PATH=

# ── DASHBOARD AUTH (opcional) ──
# Se preencher, dashboard fica protegido por basic auth
DASHBOARD_USER=
DASHBOARD_PASS=
